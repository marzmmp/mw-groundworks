# Fonts, vendor JS and images are effectively immutable — if one changes it
# gets a new build anyway. Cache them hard so a returning visitor pays for the
# 1MB hero once and never again.
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/assets/vendor/*
  Cache-Control: public, max-age=31536000, immutable
/assets/img/*
  Cache-Control: public, max-age=31536000, immutable
/assets/logos/*
  Cache-Control: public, max-age=604800

# HTML must revalidate, or a phone-number change takes a week to reach anyone.
/*.html
  Cache-Control: public, max-age=0, must-revalidate

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=()
