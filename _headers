# Fonts and vendor JS never change in place: cache them hard.
# Images DO get replaced in place (2026-10-12 recompression), and "immutable"
# kept the old 385KB files at Cloudflare edges for a year. Images now cache a day
# and every <img> URL carries ?v=<date>; bump it whenever an image is replaced.
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/assets/vendor/*
  Cache-Control: public, max-age=31536000, immutable
/assets/img/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/assets/logos/*
  Cache-Control: public, max-age=604800


# HTML must revalidate, or a phone-number change takes a week to reach
# anyone. Pages serves these extensionless, so match the real paths.
/
  Cache-Control: public, max-age=0, must-revalidate
/about
  Cache-Control: public, max-age=0, must-revalidate
/services
  Cache-Control: public, max-age=0, must-revalidate
/work
  Cache-Control: public, max-age=0, must-revalidate
/service-area
  Cache-Control: public, max-age=0, must-revalidate
/contact
  Cache-Control: public, max-age=0, must-revalidate
/404
  Cache-Control: public, max-age=0, must-revalidate

/*
  Strict-Transport-Security: max-age=31536000
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=()
